{
  "name": "barry-cache",
  "version": "0.2.2",
  "description": "Barry Cache remembers your repo.",
  "type": "module",
  "bin": {
    "barry-cache": "./dist/cli.js"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/cli.ts --target=node --outdir=dist",
    "prepack": "bun run build"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.8.0",
    "typescript": "^6.0.3"
  }
}